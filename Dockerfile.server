# Apteva release image.
#
# Build context is the GitHub Actions workspace after sibling checkouts:
#   apteva/ core/ server/ computer/ dashboard/ ui-kit/ app-sdk/ integrations/
#
# Local equivalent:
#   docker build -f apteva/Dockerfile.server -t ghcr.io/apteva/apteva:dev .

FROM oven/bun:1 AS dashboard-builder

WORKDIR /build/ui-kit
COPY ui-kit/package.json ui-kit/bun.lock ./
RUN bun install --frozen-lockfile
COPY ui-kit/ ./

WORKDIR /build/dashboard
COPY dashboard/package.json dashboard/bun.lock ./
RUN bun install --frozen-lockfile
COPY dashboard/ ./
RUN bun run build

FROM oven/bun:1 AS integrations-builder

WORKDIR /build/integrations
COPY integrations/package.json integrations/bun.lock ./
RUN bun install --frozen-lockfile
COPY integrations/ ./
RUN bun run scripts/build-ui.ts && mkdir -p dist/ui

FROM golang:1.26.5-alpine AS go-builder

ARG APTEVA_VERSION=dev
ARG BUILD_TIME=dev

RUN apk add --no-cache git jq

WORKDIR /build
COPY apteva/package.json ./apteva-package.json
COPY dashboard/package.json ./dashboard-package.json
COPY integrations/package.json ./integrations-package.json
COPY core/ ./core/
COPY computer/ ./computer/
COPY app-sdk/ ./app-sdk/
COPY server/ ./server/

RUN CLI_VERSION=$(jq -r .version /build/apteva-package.json) && \
    DASHBOARD_VERSION=$(jq -r .version /build/dashboard-package.json) && \
    INTEGRATIONS_VERSION=$(jq -r .version /build/integrations-package.json) && \
    { echo "CLI_VERSION=$CLI_VERSION"; \
      echo "DASHBOARD_VERSION=$DASHBOARD_VERSION"; \
      echo "INTEGRATIONS_VERSION=$INTEGRATIONS_VERSION"; } > /tmp/versions.env

WORKDIR /build/core
RUN . /tmp/versions.env && \
    CGO_ENABLED=0 go build \
      -ldflags="-s -w \
        -X main.Version=$APTEVA_VERSION \
        -X main.BuildTime=$BUILD_TIME \
        -X main.CLIVersion=$CLI_VERSION \
        -X main.DashboardVersion=$DASHBOARD_VERSION \
        -X main.IntegrationsVersion=$INTEGRATIONS_VERSION \
        -X main.CoreVersion=$APTEVA_VERSION" \
      -o /apteva-core ./cmd/apteva-core

WORKDIR /build/server
RUN rm -rf ./dashboard/* ./dashboard/.[!.]* ./dashboard/..?* 2>/dev/null || true
COPY --from=dashboard-builder /build/dashboard/dist/ ./dashboard/
COPY --from=integrations-builder /build/integrations/dist/ui/ /tmp/integrations-ui/
RUN rm -rf ./integrations-ui/* && mkdir -p ./integrations-ui && \
    cp -r /tmp/integrations-ui/* ./integrations-ui/ 2>/dev/null || true
COPY --from=integrations-builder /build/integrations/src/apps/ /tmp/integrations-catalog/
RUN rm -rf ./integrations-catalog/* && mkdir -p ./integrations-catalog && \
    cp -f /tmp/integrations-catalog/*.json ./integrations-catalog/ 2>/dev/null || true
RUN find ./dashboard ./integrations-ui -name '*.map' -delete
RUN . /tmp/versions.env && \
    CGO_ENABLED=0 go build \
      -ldflags="-s -w \
        -X main.Version=$APTEVA_VERSION \
        -X main.BuildTime=$BUILD_TIME \
        -X main.CLIVersion=$CLI_VERSION \
        -X main.DashboardVersion=$DASHBOARD_VERSION \
        -X main.IntegrationsVersion=$INTEGRATIONS_VERSION \
        -X main.CoreVersion=$APTEVA_VERSION" \
      -o /apteva-server .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" \
      -o /apteva-mcp-runner ./cmd/apteva-mcp-runner

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=go-builder /apteva-core /usr/local/bin/apteva-core
COPY --from=go-builder /apteva-server /usr/local/bin/apteva-server
COPY --from=go-builder /apteva-mcp-runner /usr/local/bin/apteva-mcp-runner

ENV PORT=5280
ENV APTEVA_BIND=0.0.0.0
ENV CORE_CMD=/usr/local/bin/apteva-core
ENV DB_PATH=/data/apteva.db
ENV DATA_DIR=/data
ENV APTEVA_APPS_CACHE=/data/apps
ENV QUIET=1

EXPOSE 5280
VOLUME /data

ENTRYPOINT ["apteva-server"]
