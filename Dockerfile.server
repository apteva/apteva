# Apteva — full deployment with dashboard
# Same as Dockerfile but includes the web dashboard.
#
# Build:
#   docker build -t apteva-full -f Dockerfile.server ..
#
# Run:
#   docker run -d -p 5280:5280 -v apteva-data:/data \
#     -e FIREWORKS_API_KEY=sk_... \
#     apteva-full

# ─── Build dashboard ───
FROM oven/bun:1 AS dashboard-builder
WORKDIR /build/dashboard
COPY dashboard/package.json dashboard/bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install
COPY dashboard/ ./
RUN bun run build.ts 2>/dev/null || echo "dashboard build skipped"

# ─── Build Go binaries ───
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git

WORKDIR /build
COPY core/ core/
COPY computer/ computer/
COPY server/ server/

# package.json files drive the version stamps below. Copy them individually
# so a version bump invalidates only the build step, not the Go deps cache.
COPY package.json /build/versions/umbrella.json
COPY apteva/package.json /build/versions/cli.json
COPY dashboard/package.json /build/versions/dashboard.json
COPY integrations/package.json /build/versions/integrations.json

# Build core (versioned)
WORKDIR /build/core
RUN set -eux; \
    V_UMBRELLA=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/umbrella.json | head -1); \
    V_CLI=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/cli.json | head -1); \
    BUILD=$(date -u +%Y-%m-%dT%H:%M:%SZ); \
    CGO_ENABLED=0 go build -ldflags="-s -w \
        -X main.Version=$V_UMBRELLA \
        -X main.CLIVersion=$V_CLI \
        -X main.CoreVersion=$V_UMBRELLA \
        -X main.BuildTime=$BUILD" \
        -o /apteva-core .

# Build server with embedded dashboard (versioned)
WORKDIR /build/server
COPY --from=dashboard-builder /build/dashboard/dist/ ./dashboard/
RUN set -eux; \
    V_UMBRELLA=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/umbrella.json | head -1); \
    V_CLI=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/cli.json | head -1); \
    V_DASH=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/dashboard.json | head -1); \
    V_INT=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /build/versions/integrations.json | head -1); \
    BUILD=$(date -u +%Y-%m-%dT%H:%M:%SZ); \
    echo "versions: umbrella=$V_UMBRELLA cli=$V_CLI dashboard=$V_DASH integrations=$V_INT build=$BUILD"; \
    CGO_ENABLED=0 go build -ldflags="-s -w \
        -X main.Version=$V_UMBRELLA \
        -X main.CLIVersion=$V_CLI \
        -X main.DashboardVersion=$V_DASH \
        -X main.IntegrationsVersion=$V_INT \
        -X main.CoreVersion=$V_UMBRELLA \
        -X main.BuildTime=$BUILD" \
        -o /apteva-server .

# ─── Runtime ───
FROM alpine:3.21
RUN apk add --no-cache ca-certificates chromium

COPY --from=builder /apteva-core /usr/local/bin/apteva-core
COPY --from=builder /apteva-server /usr/local/bin/apteva-server

VOLUME /data
WORKDIR /data

ENV PORT=5280
ENV CORE_CMD=/usr/local/bin/apteva-core
ENV DB_PATH=/data/apteva.db
ENV DATA_DIR=/data

EXPOSE 5280

ENTRYPOINT ["apteva-server"]
